#. Plugin Name of the plugin
#: pairs-memory-game.php
#: includes/class-pairsmg-admin-settings.php:282
msgid "Pairs - Memory Game"
msgstr "Pari - Igra spomina"

#. Plugin URI of the plugin
#: pairs-memory-game.php
msgid "https://github.com/Mult1Hunter/pairs-memory-game"
msgstr "https://github.com/Mult1Hunter/pairs-memory-game"

#. Description of the plugin
#: pairs-memory-game.php
msgid "A memory (concentration) game with your own card images, three difficulty tiers, server-verified scores, per-tier leaderboards and optional bot protection (Turnstile, reCAPTCHA, hCaptcha)."
msgstr "Igra spomina z lastnimi slikami kartic, tremi težavnostmi, strežniško preverjenimi rezultati, ločenimi lestvicami in izbirno zaščito pred boti (Turnstile, reCAPTCHA, hCaptcha)."

#. Author of the plugin
#: pairs-memory-game.php
msgid "Matic Korošec"
msgstr "Matic Korošec"

#. Author URI of the plugin
#: pairs-memory-game.php
msgid "https://nextgen-solutions.xyz"
msgstr "https://nextgen-solutions.xyz"

