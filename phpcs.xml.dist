<?xml version="1.0"?>
<ruleset name="Pairs Memory Game">
  <description>WordPress coding standards + PHP compatibility for the plugin.</description>

  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/assets/*</exclude-pattern>
  <exclude-pattern>*/blocks/*</exclude-pattern>
  <!-- Test bootstrap deliberately redefines WordPress functions as stubs. -->
  <exclude-pattern>*/tests/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="parallel" value="8"/>

  <config name="minimum_wp_version" value="6.0"/>
  <config name="testVersion" value="7.4-"/>

  <!-- Security- and correctness-focused subset of WordPress standards.
       Formatting (WordPress-Core: tabs, Yoda, spacing) is deliberately not
       enforced - the code base uses 4-space PSR-style layout. -->
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="Generic.WhiteSpace.ScopeIndent"/>
    <exclude name="WordPress.WhiteSpace"/>
    <exclude name="WordPress.Arrays"/>
    <exclude name="WordPress.PHP.YodaConditions"/>
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Squiz.Commenting"/>
    <exclude name="Generic.Commenting"/>
    <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
    <exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
    <exclude name="PEAR.Functions.FunctionCallSignature"/>
    <exclude name="Squiz.ControlStructures.ControlSignature"/>
    <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
    <exclude name="Squiz.PHP.DisallowMultipleAssignments"/>
    <exclude name="Squiz.PHP.EmbeddedPhp"/>
    <exclude name="Universal.Operators.DisallowShortTernary"/>
    <exclude name="Universal.WhiteSpace"/>
    <exclude name="Universal.ControlStructures.DisallowLonelyIf"/>
    <exclude name="Generic.ControlStructures.InlineControlStructure"/>
    <exclude name="Universal.CodeAnalysis"/>
    <exclude name="Squiz.Strings.DoubleQuoteUsage"/>
    <exclude name="Universal.Files.SeparateFunctionsFromOO"/>
    <exclude name="Generic.PHP.DisallowShortOpenTag"/>
    <exclude name="Squiz.WhiteSpace"/>
    <exclude name="Generic.Strings.UnnecessaryStringConcat"/>
    <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
    <exclude name="Universal.Operators.StrictComparisons"/>
    <exclude name="WordPress.PHP.StrictInArray"/>
    <exclude name="Universal.UseStatements"/>
    <exclude name="Generic.Files.EndFileNewline"/>
    <exclude name="Squiz.Scope"/>
    <exclude name="Universal.Constants.UppercaseMagicConstants"/>
    <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
    <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
    <exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>
    <exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
    <!-- The plugin owns one custom table; every query on it is prepared. -->
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <!-- Tokens are base64url-encoded JSON, not obfuscated code. -->
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
  </rule>
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="pairsly-memory-game"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="pairsmg"/>
        <element value="PairsMG"/>
        <element value="PAIRSMG"/>
      </property>
    </properties>
  </rule>
  <rule ref="PHPCompatibilityWP"/>
</ruleset>
