    "tier": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "align": ["wide", "full"]
  },
  "editorScript": "pairsmg-block-editor"
}
